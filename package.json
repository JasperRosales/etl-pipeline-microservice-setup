{
  "name": "pos-etl-local",
  "version": "0.1.0",
  "private": true,
  "description": "Local POS ETL microservices started with start-etl.ps1",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "db:init": "node scripts/init-db.js",
    "db:seed": "node scripts/seed-db.js",
    "db:reset": "node scripts/seed-db.js --reset",
    "health": "node scripts/health-check.js",
    "smoke": "node scripts/smoke-test.js",
    "pipeline": "node scripts/run-pipeline.js",
    "pipeline:bad": "node scripts/run-pipeline.js --input data/samples/bad-transactions.json",
    "etl:start": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\start-etl.ps1",
    "etl:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\stop-etl.ps1",
    "start:extractor": "node services/extractor/index.js",
    "start:transformer": "node services/transformer/index.js",
    "start:loader": "node scripts/init-db.js && node services/loader/index.js",
    "start:reporter": "node scripts/init-db.js && node services/reporter/index.js",
    "start:notifier": "node scripts/init-db.js && node services/notifier/index.js",
    "start:scheduler": "node services/scheduler/index.js",
    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "node-cron": "^4.2.1"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
