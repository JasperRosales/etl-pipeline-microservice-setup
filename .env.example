# Copy this file to .env in the project root and fill in the values.
# .env is gitignored - never commit real credentials or customer data (README section 8).

# --- Service ports (bound to 127.0.0.1; defaults match README section 2) ---
PORT_EXTRACTOR=3001
PORT_TRANSFORMER=3002
PORT_LOADER=3003
PORT_REPORTER=3004
PORT_NOTIFIER=3005
SCHEDULER_PORT=3006

# --- Database and logs ---
DB_PATH=./data/pos.db
LOG_DIR=./logs

# --- Scheduler (node-cron inside the scheduler service) ---
# Standard 5-field cron expression, evaluated in local time.
ETL_CRON=*/15 * * * *

# --- Source API for the extractor (README section 8) ---
# Use this URL as is. It is the shared salsa-pos-api deployed on Render:
#   https://salsa-pos-api.onrender.com/transactions
# Do not change it unless you run your own copy of salsa-pos-api.
SHEETS_ENDPOINT=https://salsa-pos-api.onrender.com/transactions
# Alternative Apps Script deployment URL, if you keep a separate one. Optional.
APPS_SCRIPT_URL=
# Token the extractor sends with each request. Required.
# Ask the project owner for the salsa-pos-api token. Do not commit it.
API_TOKEN=replace-with-a-long-random-string
